  "cards": [
    {
      "dot": "cyan",
      "title": "Main thread stays in charge",
      "items": [
        "It plans, writes code and applies advice. Child results return to this thread."
      ]
    },
    {
      "dot": "emerald",
      "title": "Final review is opt-in",
      "items": [
        "Requested review must pass. Skipped review is labeled, never claimed as accepted."
      ]
    },
    {
      "dot": "amber",
      "title": "Wait expiry keeps work running",
      "items": [
        "Same child, same run ID. Explicit cancellation stops it. Oracle/wait changes remain planned."
      ]
    }
