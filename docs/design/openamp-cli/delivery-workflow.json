  "nodes": [
    {
      "id": "request",
      "lane": "execution",
      "col": 0,
      "type": "frontend",
      "label": "交代需求",
      "sublabel": "持續對話"
    },
    {
      "id": "delegate",
      "lane": "execution",
      "col": 2,
      "type": "backend",
      "label": "主 agent 委派",
      "sublabel": "固定範圍與基準"
    },
    {
      "id": "implement",
      "lane": "execution",
      "col": 4,
      "type": "backend",
      "label": "實作與整合",
