    },
    {
      "id": "blocked",
      "lane": "outcome",
      "col": 4,
      "type": "security",
      "label": "保留工作",
      "sublabel": "顯示失敗原因"
    },
    {
      "id": "merge",
      "lane": "outcome",
      "col": 5,
      "type": "external",
      "label": "決定是否合併",
      "sublabel": "PR 已建立 ≠ 已合併"
    }
  ],
  "edges": [
    {
      "from": "request",
      "to": "delegate",
      "role": "main"
    },
    {
      "from": "delegate",
      "to": "implement",
      "role": "main"
    },
    {
      "from": "implement",
      "to": "validate",
      "role": "main"
    },
    {
      "from": "validate",
      "to": "publish",
      "label": "通過",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "from": "validate",
      "to": "blocked",
      "label": "未通過",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "publish",
      "to": "merge",
      "label": "PR 連結",
      "role": "main"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "交付預設",
      "items": ["完成後自動建立 PR；使用者決定合併"]
    },
    {
      "dot": "amber",
      "title": "無法確認時",
      "items": ["保留 worktree；未知發布結果先查證"]
    },
    {
      "dot": "cyan",
      "title": "委派按需要",
      "items": ["子 agent 寫入各自 worktree，主流程循序整合"]
    }
